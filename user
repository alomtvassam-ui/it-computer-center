import { requireAdmin } from "./_auth";

export const coursesHandler = async (event) => {
  if (event.httpMethod === "GET") {
    return {
      statusCode: 200,
      body: JSON.stringify([
        { id: 1, title: "React Course" },
        { id: 2, title: "JavaScript Basics" }
      ])
    };
  }

  if (event.httpMethod === "POST") {
    const authCheck = requireAdmin(event);

    if (authCheck.statusCode) return authCheck;

    const data = JSON.parse(event.body || "{}");

    if (!data.title) {
      return {
        statusCode: 400,
        body: JSON.stringify({ message: "Title is required" })
      };
    }

    return {
      statusCode: 200,
      body: JSON.stringify({
        message: "Course created",
        data: { id: Date.now(), title: data.title }
      })
    };
  }

  return { statusCode: 405, body: "Method Not Allowed" };
};

export { coursesHandler as handler };


